# Скопируйте в .env. Файл .env не попадает в git, архив и браузер. Всё необязательно: без настроек работает демо-режим.

# --- Панель
STRAZH_HOST=127.0.0.1
STRAZH_PORT=8000
# local — панель на своём компьютере; public — сайт с комнатами посетителей, см. docs/DEPLOY.md.
STRAZH_MODE=local
# Только для public: домен сайта, пароль владельца (от 12 символов), ключ подписи cookie.
STRAZH_PUBLIC_HOST=
STRAZH_OWNER_PASSWORD=
STRAZH_SECRET_KEY=
# Дополнительные разрешённые адреса через запятую, например имя машины в локальной сети.
STRAZH_ALLOWED_HOSTS=

# --- Учебный счёт и рынок
STRAZH_COMMISSION_BPS=5
STRAZH_EXEC_DELAY_MS=300
STRAZH_START_QTY=100
STRAZH_BUY_PRICE=1000
STRAZH_START_CASH=0
STRAZH_DEFAULT_TTL_SEC=60

# --- Telegram. Работает, только если заполнены все три поля.
TELEGRAM_BOT_TOKEN=
# Уведомления уходят только в этот чат.
TELEGRAM_CHAT_ID=
# Пользователи, которым разрешено управлять, через запятую.
TELEGRAM_ALLOWED_USERS=
# TELEGRAM_PROXY=http://127.0.0.1:10808
# polling — бот сам опрашивает Telegram; webhook — только на сайте, нужен секрет от 24 символов.
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=

# --- Языковая модель. Без ключа честный демо-режим шаблонов.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# --- Песочница T-Invest, только для scripts/check_sandbox.py. Платформа работает без неё.
# TINVEST_SANDBOX_TOKEN=
# TINVEST_CA_BUNDLE=/path/to/russian-trusted-ca.pem
# TINVEST_CONNECT_IP=
# TINVEST_BIND_INTERFACE=en0
